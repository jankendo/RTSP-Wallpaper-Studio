<Window x:Class="RTSPWallpaperStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RTSP Wallpaper Studio"
        Width="1240"
        Height="800"
        MinWidth="980"
        MinHeight="640"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D9E4F4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#172235" Padding="18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="RTSP" FontSize="30" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Wallpaper Studio" FontSize="16" Foreground="#AFC4E2" Margin="0,-3,0,28" />
                    <TextBlock Text="操作メニュー" Foreground="#7F9ABD" FontSize="12" Margin="4,0,0,8" />
                    <Button Style="{StaticResource NavButton}" Content="ホーム" Command="{Binding NavigateCommand}" CommandParameter="home" />
                    <Button Style="{StaticResource NavButton}" Content="RTSPプロファイル" Command="{Binding NavigateCommand}" CommandParameter="profiles" />
                    <Button Style="{StaticResource NavButton}" Content="ディスプレイ" Command="{Binding NavigateCommand}" CommandParameter="display" />
                    <Button Style="{StaticResource NavButton}" Content="診断と安全" Command="{Binding NavigateCommand}" CommandParameter="diagnostics" />
                    <Button Style="{StaticResource NavButton}" Content="設定" Command="{Binding NavigateCommand}" CommandParameter="settings" />
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#21314A" CornerRadius="10" Padding="12" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="緊急停止" Foreground="#FFCCCF" FontWeight="SemiBold" />
                        <TextBlock Text="Ctrl + Alt + Shift + F12" Foreground="#DDE7F6" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap" />
                        <Button Content="今すぐ停止" Command="{Binding EmergencyStopCommand}" Background="#A93846" Foreground="White" BorderThickness="0" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="34,28,34,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="RTSP Wallpaper Studio" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="映像出力とデスクトップ配置を検証してから、安全にライブ壁紙として表示します。" Foreground="{DynamicResource MutedInk}" Margin="0,5,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="#FFF2D9" CornerRadius="16" Padding="13,7">
                    <TextBlock Text="{Binding CurrentProfileStatus}" Foreground="#7B5313" FontWeight="SemiBold" />
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="home"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="壁紙の状態" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StatusMessage}" FontSize="16" Margin="0,10,0,18" TextWrapping="Wrap" />
                            <Border Background="#EEF4FF" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="次に行うこと" FontWeight="SemiBold" Foreground="#234A8F" />
                                    <TextBlock Text="1. プロファイルでRTSP URLを入力  2. 接続テスト  3. 壁紙に設定" Foreground="#34557F" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="接続テスト" Command="{Binding TestConnectionCommand}" />
                                <Button Content="壁紙に設定" Command="{Binding ApplyCommand}" Background="{DynamicResource Accent}" Foreground="White" />
                                <Button Content="壁紙を停止" Command="{Binding StopCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="profiles"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="RTSPプロファイル" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="接続先は端末内に保存され、パスワードはWindowsの保護ストアで暗号化します。" Foreground="{DynamicResource MutedInk}" Margin="0,5,0,20" TextWrapping="Wrap" />
                            <TextBlock Text="保存済みプロファイル" FontWeight="SemiBold" />
                            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Margin="0,8,0,20" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate><Border Padding="12" Margin="0,0,0,7" Background="#F2F5FA" CornerRadius="8"><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Url}" Foreground="{DynamicResource MutedInk}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel></Border></DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="RTSP URL" FontWeight="SemiBold" />
                            <TextBox Text="{Binding SelectedProfile.Url, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,5,0,4" FontSize="15" />
                            <TextBlock Text="例：rtsp://127.0.0.1:8554/switchbot3mp" Foreground="{DynamicResource MutedInk}" />
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="表示名" FontWeight="SemiBold" /><TextBox Text="{Binding SelectedProfile.DisplayName, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,5,0,0" /></StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="パスワード（任意）" FontWeight="SemiBold" /><PasswordBox PasswordChanged="PasswordBox_OnPasswordChanged" Padding="10" Margin="0,5,0,0" /></StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button Content="接続テスト" Command="{Binding TestConnectionCommand}" /><Button Content="設定を保存" Command="{Binding SaveSettingsCommand}" /></StackPanel>
                        </StackPanel>
                    </Border>

                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="display"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="ディスプレイと表示方式" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="永続IDと実際のWin32矩形を使って、再接続後も同じ画面へ戻します。" Foreground="{DynamicResource MutedInk}" Margin="0,5,0,20" TextWrapping="Wrap" />
                            <ListBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate><DataTemplate><Border Background="#F2F5FA" Padding="14" Margin="0,0,0,8" CornerRadius="8"><StackPanel><TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" /><TextBlock Text="{Binding DisplaySummary}" Foreground="{DynamicResource MutedInk}" Margin="0,3,0,0" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="配置モード" FontWeight="SemiBold" Margin="0,18,0,5" />
                            <ComboBox SelectedValue="{Binding SelectedProfile.WallpaperMode}" SelectedValuePath="Tag" Padding="8"><ComboBoxItem Content="ディスプレイごと" Tag="PerDisplay" /><ComboBoxItem Content="複製" Tag="Duplicate" /><ComboBoxItem Content="スパン" Tag="Span" /></ComboBox>
                            <TextBlock Text="映像表示" FontWeight="SemiBold" Margin="0,18,0,5" />
                            <ComboBox SelectedValue="{Binding SelectedProfile.DisplayMode}" SelectedValuePath="Tag" Padding="8"><ComboBoxItem Content="Fill（画面を埋める）" Tag="Fill" /><ComboBoxItem Content="Fit（全体を表示）" Tag="Fit" /><ComboBoxItem Content="Stretch（引き伸ばす）" Tag="Stretch" /><ComboBoxItem Content="Center（中央）" Tag="Center" /><ComboBoxItem Content="1:1（等倍）" Tag="OneToOne" /></ComboBox>
                        </StackPanel>
                    </Border>

                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="diagnostics"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="診断と安全" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="Rendererは映像出力・親ウィンドウ・矩形・Z順を確認するまで表示しません。" Foreground="{DynamicResource MutedInk}" Margin="0,5,0,18" TextWrapping="Wrap" />
                            <Border Background="#F2F5FA" CornerRadius="8" Padding="16"><TextBlock Text="{Binding DiagnosticsText}" FontFamily="Consolas" TextWrapping="Wrap" /></Border>
                            <TextBlock Text="{Binding SafeModeMessage}" Foreground="#9A5E00" TextWrapping="Wrap" Margin="0,16,0,0" />
                            <TextBlock Text="{Binding HotkeyWarning}" Foreground="#B23A48" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Rendererを再接続" Command="{Binding ReconnectCommand}" /><Button Content="デスクトップを再探索" Command="{Binding ResetDesktopCommand}" /><Button Content="ログフォルダーを開く" Command="{Binding OpenLogsCommand}" /></StackPanel>
                        </StackPanel>
                    </Border>

                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="settings"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="設定" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="変更は明示的に保存します。初回起動や異常終了時は安全側で復元を止めます。" Foreground="{DynamicResource MutedInk}" Margin="0,5,0,20" TextWrapping="Wrap" />
                            <TextBlock Text="テーマ" FontWeight="SemiBold" />
                            <ComboBox SelectedValue="{Binding ThemeMode}" SelectedValuePath="Tag" Margin="0,6,0,18" Padding="8"><ComboBoxItem Content="ライト" Tag="Light" /><ComboBoxItem Content="ダーク" Tag="Dark" /><ComboBoxItem Content="システム" Tag="System" /></ComboBox>
                            <TextBlock Text="セーフモード" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding IsSafeMode, StringFormat=現在の状態：{0}}" Foreground="{DynamicResource MutedInk}" Margin="0,6,0,18" />
                            <TextBlock Text="緊急停止ショートカット：Ctrl + Alt + Shift + F12" FontWeight="SemiBold" />
                            <Button Content="設定を保存" Command="{Binding SaveSettingsCommand}" Margin="0,22,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <DockPanel Grid.Row="2" Margin="0,18,0,0">
                <TextBlock DockPanel.Dock="Left" Text="{Binding FooterMessage}" Foreground="{DynamicResource MutedInk}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="緊急停止" Command="{Binding EmergencyStopCommand}" Background="#A93846" Foreground="White" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
