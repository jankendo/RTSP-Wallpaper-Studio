<Window x:Class="RTSPWallpaperStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RTSP Wallpaper Studio"
        Width="1180"
        Height="760"
        MinWidth="920"
        MinHeight="620"
        Background="{StaticResource WindowBackground}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="ProfileTemplate">
            <Border Padding="12" Margin="0,0,0,8" Background="White" CornerRadius="8" BorderBrush="#DCE3F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Url}" Foreground="{StaticResource MutedInk}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding LastStatus}" Foreground="{StaticResource MutedInk}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="RTSP Wallpaper Studio" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="RTSP映像をデスクトップアイコンの背面で再生するWindowsライブ壁紙" FontSize="14" Foreground="{StaticResource MutedInk}" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBackground}" Padding="16" CornerRadius="10" Margin="0,0,18,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="RTSPプロファイル" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="複数のカメラ接続先を保存できます。" Foreground="{StaticResource MutedInk}" Margin="0,4,0,14" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" ItemTemplate="{StaticResource ProfileTemplate}" BorderThickness="0" Background="Transparent" />
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource CardBackground}" Padding="20" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="接続設定" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="RTSP URL" Margin="0,18,0,4" FontWeight="SemiBold" />
                            <TextBox Text="{Binding SelectedProfile.Url, UpdateSourceTrigger=PropertyChanged}" Padding="10" FontSize="15" />
                            <TextBlock Text="初回入力例：rtsp://127.0.0.1:8554/switchbot3mp（ローカル中継サービスが必要です）" Foreground="{StaticResource MutedInk}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="表示名" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding SelectedProfile.DisplayName, UpdateSourceTrigger=PropertyChanged}" Padding="10" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="パスワード（任意）" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <PasswordBox PasswordChanged="PasswordBox_OnPasswordChanged" Padding="10" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="配置モード" FontWeight="SemiBold" Margin="0,18,0,4" />
                            <ComboBox SelectedValue="{Binding SelectedProfile.WallpaperMode}" SelectedValuePath="Tag" Padding="8">
                                <ComboBoxItem Content="ディスプレイごと" Tag="PerDisplay" />
                                <ComboBoxItem Content="複製" Tag="Duplicate" />
                                <ComboBoxItem Content="スパン" Tag="Span" />
                            </ComboBox>
                            <TextBlock Text="映像表示" FontWeight="SemiBold" Margin="0,18,0,4" />
                            <ComboBox SelectedValue="{Binding SelectedProfile.DisplayMode}" SelectedValuePath="Tag" Padding="8">
                                <ComboBoxItem Content="Fill（画面を埋める）" Tag="Fill" />
                                <ComboBoxItem Content="Fit（全体を表示）" Tag="Fit" />
                                <ComboBoxItem Content="Stretch（引き伸ばす）" Tag="Stretch" />
                                <ComboBoxItem Content="Center（中央）" Tag="Center" />
                                <ComboBoxItem Content="1:1（等倍）" Tag="OneToOne" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBackground}" Padding="20" CornerRadius="10" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="対象ディスプレイ" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="永続IDを使って再接続後の割り当てを復元します。" Foreground="{StaticResource MutedInk}" Margin="0,4,0,14" />
                            <ListBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DisplaySummary}" Foreground="{StaticResource MutedInk}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedInk}" TextWrapping="Wrap" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,22,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{Binding FooterMessage}" VerticalAlignment="Center" Foreground="{StaticResource MutedInk}" TextWrapping="Wrap" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="接続テスト" Command="{Binding TestConnectionCommand}" />
                <Button Content="壁紙を停止" Command="{Binding StopCommand}" />
                <Button Content="壁紙に設定" Background="{StaticResource Accent}" Foreground="White" Command="{Binding ApplyCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
