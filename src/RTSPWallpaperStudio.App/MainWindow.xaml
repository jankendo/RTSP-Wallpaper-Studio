<Window x:Class="RTSPWallpaperStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RTSP Wallpaper Studio"
        Width="1240" Height="800" MinWidth="980" MinHeight="640"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Opacity="1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBorder}" /><Setter TargetName="Chrome" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}" />
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{DynamicResource DangerBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBackground}" />
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="NavigationItemContainer" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavRoot" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="10,10">
                            <Grid>
                                <Border x:Name="Indicator" Width="4" HorizontalAlignment="Left" Background="{DynamicResource NavigationFocusBorder}" CornerRadius="2" Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Margin="9,0,0,0">
                                    <TextBlock x:Name="NavIcon" Text="{Binding IconGlyph}" FontSize="18" Width="28" Foreground="{DynamicResource SidebarForeground}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="NavLabel" Text="{Binding Label}" FontSize="14" Foreground="{DynamicResource SidebarForeground}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavRoot" Property="Background" Value="{DynamicResource NavigationSelectedBackground}" />
                                <Setter TargetName="NavIcon" Property="Foreground" Value="{DynamicResource NavigationSelectedForeground}" />
                                <Setter TargetName="NavLabel" Property="Foreground" Value="{DynamicResource NavigationSelectedForeground}" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavRoot" Property="Background" Value="{DynamicResource NavigationHoverBackground}" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="NavRoot" Property="BorderBrush" Value="{DynamicResource NavigationFocusBorder}" /><Setter TargetName="NavRoot" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="NavRoot" Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="232" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" Padding="18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="RTSP" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource SidebarForeground}" />
                    <TextBlock Text="Wallpaper Studio" FontSize="16" Foreground="{DynamicResource SidebarMutedForeground}" Margin="0,-3,0,28" />
                    <TextBlock Text="操作メニュー" Foreground="{DynamicResource SidebarMutedForeground}" FontSize="12" Margin="4,0,0,8" />
                    <ListBox ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource NavigationItemContainer}" Background="Transparent" BorderThickness="0"
                             KeyboardNavigation.TabNavigation="Local" AutomationProperties.Name="メインナビゲーション" />
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource NavigationHoverBackground}" CornerRadius="10" Padding="12" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="緊急停止" Foreground="#FFCCCF" FontWeight="SemiBold" />
                        <TextBlock Text="Ctrl + Alt + Shift + F12" Foreground="{DynamicResource SidebarForeground}" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap" />
                        <Button Content="今すぐ停止" Command="{Binding EmergencyStopCommand}" Style="{StaticResource DangerButton}" AutomationProperties.Name="壁紙を緊急停止" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="34,28,34,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="RTSP Wallpaper Studio" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="映像出力とデスクトップ配置を検証してから、安全にライブ壁紙として表示します。" Foreground="{DynamicResource MutedInk}" Margin="0,5,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="{DynamicResource ButtonBackground}" CornerRadius="16" Padding="13,7"><TextBlock Text="{Binding CurrentProfileStatus}" Foreground="{DynamicResource ButtonForeground}" FontWeight="SemiBold" /></Border>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border VerticalAlignment="Top">
                        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="home"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel>
                            <TextBlock Text="壁紙の状態" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StatusMessage}" FontSize="16" Margin="0,10,0,18" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RelayStatus}" Foreground="{DynamicResource MutedInk}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <Border Background="{DynamicResource ButtonBackground}" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="接続テストの進行状況" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ConnectionTestStage}" Foreground="{DynamicResource MutedInk}" Margin="0,4,0,0" />
                                    <ProgressBar Value="{Binding ConnectionTestProgress}" Maximum="100" Height="8" Margin="0,9,0,6" />
                                    <ListBox ItemsSource="{Binding ConnectionTestSteps}" Height="72" BorderThickness="0" Background="Transparent" FontSize="12" />
                                    <TextBlock Text="{Binding ConnectionTestErrorCode}" Foreground="{DynamicResource DangerBackground}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource ButtonBackground}" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                                <StackPanel><TextBlock Text="次に行うこと" FontWeight="SemiBold" /><TextBlock Text="1. プロファイルでRTSP URLを入力  2. 接続テスト  3. 壁紙に設定" Foreground="{DynamicResource MutedInk}" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="接続テスト" Command="{Binding TestConnectionCommand}" Style="{StaticResource SecondaryButton}" />
                                <Button Content="テスト成功後に壁紙へ設定" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" />
                                <Button Content="壁紙を停止" Command="{Binding StopCommand}" Style="{StaticResource SecondaryButton}" />
                                <Button Content="キャンセル" Command="{Binding CancelConnectionTestCommand}" Style="{StaticResource QuietButton}" Visibility="{Binding IsConnectionTestRunning, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border VerticalAlignment="Top">
                        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="profiles"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel>
                            <TextBlock Text="RTSPプロファイル" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="入力欄の認証情報を優先し、次にURL内認証情報、最後に保存済み保護パスワードを使います。パスワードはログへ出力しません。" Foreground="{DynamicResource MutedInk}" Margin="0,5,0,20" TextWrapping="Wrap" />
                            <TextBlock Text="保存済みプロファイル" FontWeight="SemiBold" />
                            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Margin="0,8,0,20" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate><DataTemplate><Border Padding="12" Margin="0,0,0,7" Background="{DynamicResource ButtonBackground}" CornerRadius="8"><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Url}" Foreground="{DynamicResource MutedInk}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="RTSP URL" FontWeight="SemiBold" />
                            <TextBox Text="{Binding SelectedProfile.Url, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,5,0,4" FontSize="15" />
                            <TextBlock Text="例：rtsp://127.0.0.1:8554/switchbot3mp" Foreground="{DynamicResource MutedInk}" />
                            <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="表示名" FontWeight="SemiBold" /><TextBox Text="{Binding SelectedProfile.DisplayName, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,5,0,0" /></StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="ユーザー名（任意）" FontWeight="SemiBold" /><TextBox Text="{Binding UsernameInput, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,5,0,0" /></StackPanel>
                            </Grid>
                            <TextBlock Text="パスワード（任意）" FontWeight="SemiBold" Margin="0,18,0,0" /><PasswordBox PasswordChanged="PasswordBox_OnPasswordChanged" Padding="10" Margin="0,5,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button Content="接続テスト" Command="{Binding TestConnectionCommand}" Style="{StaticResource SecondaryButton}" /><Button Content="設定を保存" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" /></StackPanel>
                        </StackPanel>
                    </Border>

                    <Border VerticalAlignment="Top">
                        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="display"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel>
                            <TextBlock Text="ディスプレイと表示方式" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="永続IDと実際のWin32矩形を使って、再接続後も同じ画面へ戻します。" Foreground="{DynamicResource MutedInk}" Margin="0,5,0,20" TextWrapping="Wrap" />
                            <ListBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource ButtonBackground}" Padding="14" Margin="0,0,0,8" CornerRadius="8"><StackPanel><TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" /><TextBlock Text="{Binding DisplaySummary}" Foreground="{DynamicResource MutedInk}" Margin="0,3,0,0" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
                            <TextBlock Text="配置モード" FontWeight="SemiBold" Margin="0,18,0,5" /><ComboBox SelectedValue="{Binding SelectedProfile.WallpaperMode}" SelectedValuePath="Tag" Padding="8"><ComboBoxItem Content="ディスプレイごと" Tag="PerDisplay" /><ComboBoxItem Content="複製" Tag="Duplicate" /><ComboBoxItem Content="スパン" Tag="Span" /></ComboBox>
                            <TextBlock Text="映像表示" FontWeight="SemiBold" Margin="0,18,0,5" /><ComboBox SelectedValue="{Binding SelectedProfile.DisplayMode}" SelectedValuePath="Tag" Padding="8"><ComboBoxItem Content="Fill（画面を埋める）" Tag="Fill" /><ComboBoxItem Content="Fit（全体を表示）" Tag="Fit" /><ComboBoxItem Content="Stretch（引き伸ばす）" Tag="Stretch" /><ComboBoxItem Content="Center（中央）" Tag="Center" /><ComboBoxItem Content="1:1（等倍）" Tag="OneToOne" /></ComboBox>
                        </StackPanel>
                    </Border>

                    <Border VerticalAlignment="Top">
                        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="diagnostics"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel>
                            <TextBlock Text="診断と安全" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Rendererは映像出力・親ウィンドウ・矩形・Z順を確認するまで表示しません。" Foreground="{DynamicResource MutedInk}" Margin="0,5,0,18" TextWrapping="Wrap" />
                            <Border Background="{DynamicResource ButtonBackground}" CornerRadius="8" Padding="16"><TextBlock Text="{Binding DiagnosticsText}" FontFamily="Consolas" TextWrapping="Wrap" /></Border>
                            <TextBlock Text="{Binding ConnectionTestTechnicalDetails}" Foreground="{DynamicResource MutedInk}" TextWrapping="Wrap" Margin="0,16,0,0" />
                            <TextBlock Text="{Binding SafeModeMessage}" Foreground="#9A5E00" TextWrapping="Wrap" Margin="0,16,0,0" /><TextBlock Text="{Binding HotkeyWarning}" Foreground="{DynamicResource DangerBackground}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Rendererを再接続" Command="{Binding ReconnectCommand}" Style="{StaticResource SecondaryButton}" /><Button Content="デスクトップを再探索" Command="{Binding ResetDesktopCommand}" Style="{StaticResource SecondaryButton}" /><Button Content="ログフォルダーを開く" Command="{Binding OpenLogsCommand}" Style="{StaticResource QuietButton}" /></StackPanel>
                        </StackPanel>
                    </Border>

                    <Border VerticalAlignment="Top">
                        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="settings"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel>
                            <TextBlock Text="設定" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="変更は明示的に保存します。初回起動や異常終了時は安全側で復元を止めます。" Foreground="{DynamicResource MutedInk}" Margin="0,5,0,20" TextWrapping="Wrap" />
                            <TextBlock Text="テーマ" FontWeight="SemiBold" /><ComboBox SelectedValue="{Binding ThemeMode}" SelectedValuePath="Tag" Margin="0,6,0,18" Padding="8"><ComboBoxItem Content="ライト" Tag="Light" /><ComboBoxItem Content="ダーク" Tag="Dark" /><ComboBoxItem Content="システム" Tag="System" /></ComboBox>
                            <TextBlock Text="セーフモード" FontWeight="SemiBold" /><TextBlock Text="{Binding IsSafeMode, StringFormat=現在の状態：{0}}" Foreground="{DynamicResource MutedInk}" Margin="0,6,0,18" /><TextBlock Text="緊急停止ショートカット：Ctrl + Alt + Shift + F12" FontWeight="SemiBold" /><Button Content="設定を保存" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,22,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <DockPanel Grid.Row="2" Margin="0,18,0,0"><TextBlock DockPanel.Dock="Left" Text="{Binding FooterMessage}" Foreground="{DynamicResource MutedInk}" TextWrapping="Wrap" VerticalAlignment="Center" /><TextBlock DockPanel.Dock="Right" Text="接続テスト成功後のみ壁紙を表示" Foreground="{DynamicResource MutedInk}" VerticalAlignment="Center" Margin="12,0,0,0" /></DockPanel>
        </Grid>
    </Grid>
</Window>
